RAG_CSS = """
<style>
/* ── 페이지 전체 스크롤 차단 ─────────────────────── */
section.main > div.block-container {
    overflow: hidden !important;
    height: 100vh;
    padding-bottom: 0 !important;
}

/* ── 채팅 메시지 버블 ────────────────────────────── */
[data-testid="stChatMessage"] {
